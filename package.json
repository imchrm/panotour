{
  "name": "panotour",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "editor":       "npm run dev --workspace=packages/editor",
    "electron":     "npm run start --workspace=packages/electron",
    "server":       "node packages/server/server.js",
    "dev":          "concurrently -n server,editor -c cyan,green \"npm run server\" \"npm run editor\"",
    "tiler":        "npm run --workspace=packages/tiler",
    "build:editor": "npm run build --workspace=packages/editor",
    "build:exe":    "npm run build --workspace=packages/editor -- --base=./ && npm run build --workspace=packages/electron"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}